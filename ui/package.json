{
  "name": "@inari/ext-argocd-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Inari ArgoCD reference UI extension: ClusterTab, InstanceActions, CatalogCard (Module Federation remote)",
  "scripts": {
    "dev": "inari-ui-ext dev ./src/index.tsx",
    "build": "inari-ui-ext build ./src/index.tsx --name inari-ext-argocd",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@7k-inari/ui-plugin-sdk": "0.1.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
